# ================================================================
# docker-compose 的环境变量来源（复制为 .env 后填写）
#
#   cp .env.example .env
#
# ⚠️ .env 含密钥，绝不能提交到 git（根目录 .gitignore 已排除 .env，
#    本文件 .env.example 只是模板，不含任何真实密钥）
# ================================================================

# ── 必填：JWT 签名密钥 ──────────────────────────────────────
# 生成：openssl rand -hex 32
# 缺失时 docker compose 会拒绝启动；泄露等于所有人可伪造登录凭证
SELF_GROW_JWT_SECRET=

# ── 公网部署必填：CORS 允许的来源 ───────────────────────────
# 后端默认只放行 localhost / 127.0.0.1，公网访问必须显式填自己的域名
# 多个用逗号分隔，例如：https://grow.example.com,https://www.example.com
# 填 * 会关闭凭证支持（等于放弃登录功能），不要这么干
SELF_GROW_CORS_ORIGINS=http://localhost:3001

# ── AI（可选）──────────────────────────────────────────────
# 也可留空，改为登录后在「用户中心 → 模型信息」配置（存 model_configs 表，可热切换）
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 语音识别（表达训练的语音输入需要）
DASHSCOPE_API_KEY=

# ── 安全开关 ────────────────────────────────────────────────
# 1 = 跳过登录，任何人可免密访问（仅供本地开发/演示）
# 生产环境必须留空或 0
SELF_GROW_TRUSTED_MODE=0
