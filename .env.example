# ================================================================
# docker-compose 的环境变量来源（复制为 .env 后填写）
#
#   cp .env.example .env
#
# ⚠️ .env 含密钥，绝不能提交到 git（根目录 .gitignore 已排除 .env，
#    本文件 .env.example 只是模板，不含任何真实密钥）
# ================================================================

# ── 必填：JWT 签名密钥 ──────────────────────────────────────
# 生成：openssl rand -hex 32
# 缺失时 docker compose 会拒绝启动；泄露等于所有人可伪造登录凭证
#
# 推荐用 sed 就地替换（别用 >> 追加，否则本文件里已有一行，会产生重复键）：
#   sed -i "s|^SELF_GROW_JWT_SECRET=.*|SELF_GROW_JWT_SECRET=$(openssl rand -hex 32)|" .env
SELF_GROW_JWT_SECRET=

# ── 公网部署必填：CORS 允许的来源 ───────────────────────────
# 后端默认只放行 localhost / 127.0.0.1，公网访问必须显式填自己的域名
# 多个用逗号分隔，例如：https://grow.example.com,https://www.example.com
# 填 * 会关闭凭证支持（等于放弃登录功能），不要这么干
SELF_GROW_CORS_ORIGINS=http://localhost:3001

# ── 数据库 ─────────────────────────────────────────────────
# mysql（默认，用 compose 里的 mysql 服务）/ sqlite（回退到 data 卷里的 data.db）
# 迁移期想整体回滚：把这行改成 sqlite，然后 `docker compose up -d app mcp`
# ⚠️ 已经在跑 sqlite 版本、要切 mysql 的话，**先迁数据再切**：
#      docker compose up -d mysql
#      docker compose run --rm app python tools/migrate_sqlite_to_mysql.py
SELF_GROW_DB_BACKEND=mysql

# compose 里 app / mcp 连的 MySQL 主机名 —— **必须是服务名 mysql**，
# 写 127.0.0.1 会指向容器自己
SELF_GROW_MYSQL_HOST=mysql

# MySQL 口令。⚠️ 下面两个默认值是**占位符，生产必须改**：
#   openssl rand -hex 16
# 改完记得 `docker compose down && docker compose up -d`；
# 注意：这几个变量只在 **mysql 容器首次初始化**时生效，
# 卷里已有数据的话，改这里不会改掉已有账号的口令（要进容器手动 ALTER USER）
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=self_grow
MYSQL_USER=self_grow
MYSQL_PASSWORD=

# ── AI（可选）──────────────────────────────────────────────
# 也可留空，改为登录后在「用户中心 → 模型信息」配置（存 model_configs 表，可热切换）
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 语音识别（表达训练的语音输入需要）
DASHSCOPE_API_KEY=

# ── 安全开关 ────────────────────────────────────────────────
# 1 = 跳过登录，任何人可免密访问（仅供本地开发/演示）
# 生产环境必须留空或 0
SELF_GROW_TRUSTED_MODE=0

# ── 构建期（可选）：pip 源 ──────────────────────────────────
# 不填则默认走清华源（国内服务器必需，直连 pypi.org 实测 388 秒后失败）
# 海外机器改成官方源：
# PIP_INDEX_URL=https://pypi.org/simple
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ── 时区（可选）────────────────────────────────────────────
# 不填默认 Asia/Shanghai。容器默认 UTC，会导致定时任务晚 8 小时、日期算错
TZ=Asia/Shanghai
