# AI API 配置
AI_API_BASE_URL=https://one.loll.xyz/v1
AI_API_KEY=sk-你的key
AI_MODEL=gemini-2.5-pro-exp-03-25

# 服务端口
PORT=3001

# 鉴权密钥（必填，缺失直接拒绝启动）。生成：openssl rand -hex 32
SELF_GROW_JWT_SECRET=

# 前端目录（留空则后端只提供 API）
# 例：SELF_GROW_FRONTEND_DIR=D:/pycharm/projec/self_grow_system/frontend
SELF_GROW_FRONTEND_DIR=

# ── 数据库 ────────────────────────────────────────────────
# mysql（默认）/ sqlite（回退到 SELF_GROW_DATA_DIR/data.db）
# 本地开发想用 SQLite 就跑得起来，不用先起 MySQL
SELF_GROW_DB_BACKEND=mysql

SELF_GROW_MYSQL_HOST=127.0.0.1
SELF_GROW_MYSQL_PORT=3306
SELF_GROW_MYSQL_USER=self_grow
SELF_GROW_MYSQL_PASSWORD=
SELF_GROW_MYSQL_DATABASE=self_grow

# 连接池上限。⚠️ 必须 ≥ 并发线程数：协调 Agent 会用 asyncio.gather 并行跑多个
# 子 Agent，每个工具调用都 to_thread + get_conn()。池满时 DBUtils 的 blocking=True
# 是**无限等待（没有超时）** → 整站卡死。别往下调
SELF_GROW_MYSQL_POOL_SIZE=20

# 会话时区。MySQL 服务端跑 UTC 时靠它补偿（默认 +08:00）
# SELF_GROW_MYSQL_TIME_ZONE=+08:00
